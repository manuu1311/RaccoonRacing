UiLoadingScreen="*uid://cukvs5a5kq71l"
DebugPanel="*uid://b2pa455vs7kan"
InputModeManager="*uid://dwrp3vuem8t7u"
DebugConsole="*uid://cmqp2uph5pmob"
GyroController="*uid://ckjcb4m87sbar"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=500
window/size/viewport_height=500
window/size/always_on_top=true
window/size/window_width_override=750
window/size/window_height_override=750
window/stretch/mode="canvas_items"
window/handheld/orientation=4
mouse_cursor/custom_image="uid://4l3jsqcdtk02"
window/quality/msaa_2d=0

[editor_plugins]

enabled=PackedStringArray("res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/place_helper/plugin.cfg", "res://addons/virtual_joystick_DX/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/Images/": "gray",
"res://Assets/Scenes/": "teal",
"res://scripts/": "purple"
}

[global_group]

Body="Car collision bodies"
default_focus="Default focus for controller"

