config_version=5

[application]

config/name="RaccoonRacing"
config/description="Remake of the flash game \"Raccoon Racing\"."
config/version="2.3.0"
run/main_scene="uid://c8wmuf22nxpku"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=35
boot_splash/image="uid://d4hcljkb7k4uc"
config/icon="uid://d4hcljkb7k4uc"
boot_splash/minimum_display_time=2000

[audio]

buses/default_bus_layout="uid://st04fndhsei0"

[autoload]

ButtonSounds="*uid://dgr8bl747n46h"
MusicPlayer="*uid://bfxu6iei27c8q"
GameData="*uid://1tl2lmg3lc0r"
UiOverAnimation="*uid://dmkr4vnw6jejh"
Game="*uid://da52fyc101u0t"
NetworkTime="*uid://cnqdxyjptkfvp"
NetworkTimeSynchronizer="*uid://5rmn2ik3kjo8"
NetworkRollback="*uid://gas743comroj"
NetworkEvents="*uid://bdmobxxptryj0"
NetworkPerformance="*uid://cqgf7aqmjfoa3"
WindowTiler="*uid://cmqjajhjgffm1"
