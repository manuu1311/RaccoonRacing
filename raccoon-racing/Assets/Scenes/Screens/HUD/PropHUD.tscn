[sub_resource type="Shader" id="Shader_w65gf"]
code = "shader_type canvas_item;

uniform float effect_strength : hint_range(0.0, 1.0) = 0.0;
uniform vec2 blur_amount = vec2(25.0, 25.0);
uniform vec4 mult_term = vec4(0.0, 0.0, 0.0, 1.0);
uniform vec4 add_term = vec4(1.0, 1.0, 1.0, 0.0);

// Number of samples per axis — increase for quality, costs performance
const int SAMPLES = 4;

void fragment() {
    vec2 tex_size = vec2(textureSize(TEXTURE, 0));
    vec2 current_blur = (blur_amount / tex_size) * effect_strength;

    vec4 blurred_color = vec4(0.0);
    float total_weight = 0.0;

    // Sweep uniformly across the full blur radius (not just at the edges)
    for (int x = -SAMPLES; x <= SAMPLES; x++) {
        for (int y = -SAMPLES; y <= SAMPLES; y++) {
            vec2 offset = (vec2(float(x), float(y)) / float(SAMPLES)) * current_blur;
            blurred_color += texture(TEXTURE, UV + offset);
            total_weight += 1.0;
        }
    }
    blurred_color /= total_weight;

    // Your color transform (unchanged)
    vec4 flash_color = blurred_color * mult_term;
    flash_color.rgb += add_term.rgb * blurred_color.a;
    flash_color.a += add_term.a;
    flash_color = clamp(flash_color, 0.0, 1.0);

    vec4 original_color = texture(TEXTURE, UV);
    COLOR = mix(original_color, flash_color, effect_strength);
}"

